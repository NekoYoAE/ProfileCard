{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "profile-card",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "./style",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
